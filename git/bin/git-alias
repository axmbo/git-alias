#!/usr/bin/env sh
# git-alias — gerencia os aliases do Git (entradas "alias.*" do git config).
#
# Uso:
#   git alias                        Mostra a sintaxe de uso
#   git alias help                   Idem (veja a nota sobre --help)
#   git alias --list                 Lista todos os aliases
#   git alias --export [<arquivo>]   Exporta em formato gitconfig; sem
#                                    <arquivo>, escreve na saída padrão
#   git alias <nome>                 Mostra a definição de um alias
#   git alias <nome> '<cmd>'         Cria ou atualiza um alias
#   git alias --unset <nome>         Remove um alias
#
# Nota: "git alias --help" é interceptado pelo próprio Git (ele tenta abrir a
# man page "git-alias", que não existe). Use "git alias" ou "git alias help".

set -eu

usage() {
	cat <<'EOF'
Sintaxe de uso:
  git alias                        (Mostra esta ajuda)
  git alias help                   (idem; '--help' e capturado pelo Git)
  git alias --list                 (Lista todos os atalhos)
  git alias --export [<arquivo>]   (Exporta os atalhos em formato gitconfig;
                                    sem <arquivo>, escreve na saida padrao)
  git alias <nome>                 (Mostra a definicao de um atalho especifico)
  git alias <nome> '<cmd>'         (Cria ou atualiza um atalho)
  git alias --unset <nome>         (Remove um atalho)

Exemplos:
  git alias teste '!echo teste # Meu comando'
  git alias gone
  git alias --unset teste
  git alias --export ~/Dev/dotfiles/git/aliases.gitconfig
EOF
}

# git config sobre a fonte pedida: <src> vazio = config mesclado (global +
# includes); senão, o arquivo <src> isolado.
gc() {
	src="$1"
	shift
	if [ -n "$src" ]; then
		git config --file "$src" "$@"
	else
		git config "$@"
	fi
}

# Cria um arquivo temporário com o cabeçalho padrão seguido da seção [alias]
# em ordem alfabética estável (LC_ALL=C, para não variar com o locale) e ecoa
# o caminho dele. $1: arquivo-fonte a ler; vazio = git config mesclado
# (global + includes). $2: diretório do temporário (default $TMPDIR) — quem
# vai substituir um arquivo passa o diretório dele, para o mv final ser no
# mesmo filesystem e atômico. O escaping fica a cargo do próprio "git config
# --file", que também garante um arquivo reimportável via [include]. O
# dispatcher "alias.alias" é omitido de propósito: quando este script está no
# PATH, ele é a implementação de "git alias", e uma cópia inline no arquivo
# faria sombra nele.
alias_render() {
	from="${1:-}"
	tmp="$(mktemp "${2:-${TMPDIR:-/tmp}}/git-alias.XXXXXX")"
	{
		printf '# Gerado por: git alias --export\n'
		printf '# Nao edite a mao; rode o comando novamente para atualizar.\n\n'
	} >"$tmp"
	gc "$from" --get-regexp '^alias\.' 2>/dev/null \
		| cut -d. -f2- | cut -d' ' -f1 | LC_ALL=C sort -u \
		| while IFS= read -r name; do
			[ "$name" = "alias" ] && continue
			git config --file "$tmp" "alias.$name" "$(gc "$from" --get "alias.$name")"
		done
	printf '%s\n' "$tmp"
}

# Põe o conteúdo de <tmp> em <dest> e remove <tmp>. Se <dest> for um symlink
# (layout comum de gerenciadores de dotfiles), escreve através dele para
# preservar o link e o arquivo-alvo real; senão faz mv (atômico quando <tmp>
# está no mesmo diretório, ver alias_render).
replace_file() {
	if [ -L "$2" ]; then
		cat "$1" >"$2"
		rm -f "$1"
	else
		mv "$1" "$2"
	fi
}

# Exporta a seção [alias] em formato gitconfig. Sem <target>, escreve na
# saída padrão; com <target>, substitui o arquivo.
alias_export() {
	target="${1:-}"
	if [ -n "$target" ]; then
		tmp="$(alias_render '' "$(dirname -- "$target")")"
		replace_file "$tmp" "$target"
		echo "Aliases exportados para $target" >&2
	else
		tmp="$(alias_render '')"
		cat "$tmp"
		rm -f "$tmp"
	fi
}

# Reescreve <arquivo> ordenado e com o cabeçalho padrão. Idempotente;
# chamado após cada gravação no arquivo de aliases versionado, para manter o
# diff de commit mínimo.
alias_normalize() {
	tmp="$(alias_render "$1" "$(dirname -- "$1")")"
	replace_file "$tmp" "$1"
}

# Descobre o arquivo de aliases versionado: o primeiro caminho em
# include.path (do config global) cujo conteúdo tem o cabeçalho que este
# script escreve em --export. Escreve o caminho na saída padrão, ou nada se
# nenhum casar. Expande "~" no começo do caminho; ignora o que não for
# arquivo legível.
alias_file() {
	git config --global --get-all include.path 2>/dev/null \
		| while IFS= read -r p; do
			case "$p" in
			'~') p="$HOME" ;;
			'~/'*) p="$HOME/${p#'~/'}" ;;
			esac
			[ -f "$p" ] || continue
			if head -n 3 "$p" | grep -qF '# Gerado por: git alias --export'; then
				printf '%s\n' "$p"
				break
			fi
		done
	return 0
}

main() {
	if [ "$#" -eq 0 ]; then
		usage
		return 0
	fi

	case "$1" in
	help | -h | --help)
		usage
		return 0
		;;
	--list)
		git config --get-regexp '^alias\.' \
			| grep -v '^alias\.alias ' \
			| sed 's/alias\.\([^ ]*\) \(.*\)/\1 = \2/'
		return 0
		;;
	--export)
		alias_export "${2:-}"
		return 0
		;;
	--unset)
		if [ -z "${2:-}" ]; then
			echo "Erro: Informe o nome do atalho para remover. Ex: git alias --unset <nome>" >&2
			return 2
		fi
		f="$(alias_file)"
		from_file=0
		from_global=0
		if [ -n "$f" ] && git config --file "$f" --unset-all "alias.$2" 2>/dev/null; then
			alias_normalize "$f"
			from_file=1
		fi
		if git config --global --unset-all "alias.$2" 2>/dev/null; then
			from_global=1
		fi
		if [ "$from_file" -eq 1 ] && [ "$from_global" -eq 1 ]; then
			echo "Alias '$2' removido de $f e do git config --global."
		elif [ "$from_file" -eq 1 ]; then
			echo "Alias '$2' removido de $f."
		elif [ "$from_global" -eq 1 ] && [ -n "$f" ]; then
			echo "Alias '$2' removido do git config --global (não estava no arquivo de aliases)."
		elif [ "$from_global" -eq 1 ]; then
			echo "Alias '$2' removido do git config --global (nenhum arquivo de aliases incluído encontrado)."
		else
			echo "Aviso: O alias '$2' não existe ou já foi removido."
		fi
		return 0
		;;
	esac

	if [ "$#" -eq 2 ]; then
		f="$(alias_file)"
		if [ -n "$f" ]; then
			git config --file "$f" "alias.$1" "$2"
			alias_normalize "$f"
			if git config --global --unset-all "alias.$1" 2>/dev/null; then
				echo "Alias '$1' gravado em $f (cópia obsoleta em git config --global removida)."
			else
				echo "Alias '$1' gravado em $f."
			fi
		else
			git config --global "alias.$1" "$2"
			echo "Alias '$1' gravado no git config --global (nenhum arquivo de aliases incluído encontrado)."
		fi
		return 0
	fi

	if [ "$#" -eq 1 ]; then
		cmd="$(git config --get "alias.$1" 2>/dev/null || true)"
		if [ -n "$cmd" ]; then
			echo "$1 = $cmd"
		else
			echo "Aviso: O alias '$1' não foi encontrado."
		fi
		return 0
	fi

	usage
	return 2
}

main "$@"
