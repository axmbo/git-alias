# Gerado por: git alias --export
# Nao edite a mao; rode o comando novamente para atualizar.
# Formato: 1

[alias]
	br = branch
	ci = commit
	co = checkout
	gone = "!git branch -vv | grep ': gone]' | awk '{print $1}' | xargs -r git branch -D # Limpa as branches locais orfas"
	st = status
	stl = status -- .
